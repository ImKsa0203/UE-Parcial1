# -----------------------------
# Unreal Engine standard ignores
# -----------------------------

# Build artifacts
Binaries/
DerivedDataCache/
Saved/
Intermediate/

# Project specific intermediates
Plugins/*/Intermediate/
Plugins/*/Binaries/

# VS / IDE files
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# OS junk
.DS_Store
Thumbs.db

# Cache and generated assets
*_BuiltData.uasset

# Ignore common compiled outputs
*.obj
*.o
*.so
*.dll
*.exe
*.pdb

# Editor autosaves
Autosaves/

# Local config and logs
Saved/
Logs/

# Do NOT ignore Config/ — keep engine/project configs
!Config/
!Source/

# If you use Rider
.idea/

# If packaging creates these
Build/*

# BUT keep these (Unreal requires them)
!Build/*.ico
!Build/*/PakBlacklist*.txt